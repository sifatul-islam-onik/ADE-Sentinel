# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# --- Large artefacts: trained models and raw corpora are not in git ---
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
*.jsonl
*.bin
*.kv
*.npy
*.pt
*.ckpt
*.safetensors

# The top-level artefact dir only. NOTE: no trailing comment on the pattern
# line - '#' only starts a comment at the START of a line, so an inline one
# becomes part of the pattern and silently matches nothing.
/models/
!/models/emb_matrices/vocab.json

# --- data/splits/ IS committed on purpose. Do not ignore it. ---

# Derived corpora: large, regenerable from data/pubmed_corpus.jsonl
data/pubmed_sentences.txt
*.txt.gz

# --- Local noise ---
.DS_Store
Thumbs.db
kaggle.json
.env
# Word lock files, created whenever a .docx is open
~$*
